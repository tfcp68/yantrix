{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["vitest/globals"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["src", "__tests__", "vite.config.ts"]
}
