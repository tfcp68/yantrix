    def _listen(event_meta):
        payload = event_meta.get('meta')
        return {
            'action': actions_dictionary['<%~ it.listener.actionName %>'],
            'payload': {
<% for (const line of it.listener.payloadLines) { %>
                <%~ line %>,
<% } %>
            },
        }

    event_adapter.add_event_listener(event_dictionary['<%~ it.listener.eventIdentifier %>'], _listen)
