    def _emit(transition):
        prev_context = transition.get('context')
        return [
<% for (const ev of it.emitter.events) { %>
            {
                'event': event_dictionary['<%~ ev.eventIdentifier %>'],
                'meta': {
<% for (const line of ev.metaLines) { %>
                    <%~ line %>,
<% } %>
                },
            },
<% } %>
        ]

    event_adapter.add_event_emitter(states_dictionary['<%~ it.emitter.stateId %>'], _emit)
