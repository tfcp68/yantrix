export const statesDictionary = <%~ JSON.stringify(it.stateDictionary.getDictionary(), null, 2) %>;

export const actionsDictionary = <%~ JSON.stringify(it.actionDictionary.getDictionary(), null, 2) %>;

export const eventDictionary = {
<% for (const name of Object.keys(it.eventDictionary.getDictionary())) { %>
  [<%~ JSON.stringify(name) %>]: GlobalEventDictionary.resolveEvent(<%~ JSON.stringify(name) %>),
<% } %>
}<% if (it.hasTypes) { %> as const<% } %>;

export const functionDictionary = new FunctionDictionary();

export const actionsMap = <%~ JSON.stringify(it.dictionaries.actionsMap, null, 2) %><% if (it.hasTypes) { %> as const<% } %>;

export const statesMap = <%~ JSON.stringify(it.dictionaries.statesMap, null, 2) %><% if (it.hasTypes) { %> as const<% } %>;
